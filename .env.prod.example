# ============================================================================
#  Site Beyond Expertise 2026 — variables de PRODUCTION
#  Copier en `.env` sur le VPS puis remplir les secrets.
#  NE JAMAIS committer le vrai .env (déjà ignoré par .gitignore).
# ============================================================================

# ── Domaine public ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://beyond-expertise.com
# API appelée par le navigateur (formulaires). Relatif → Next.js proxifie
# /api/v1 vers le conteneur beyond-api. Ne pas mettre d'URL absolue ici.
NEXT_PUBLIC_API_URL=/api/v1

# ── Réseau interne (laisser tel quel sauf si tu renommes les services) ──────
# Cible du proxy Next pour /api/v1 (utilisée au BUILD de l'image web)
API_PROXY_TARGET=http://beyond-api:4000
# URL interne pour le rendu serveur du site (runtime)
API_INTERNAL_URL=http://beyond-api:4000/api/v1

# ── PostgreSQL (volume Docker nommé, AUCUN port exposé sur l'hôte) ──────────
POSTGRES_DB=beyond_expertise
POSTGRES_USER=beyond
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_fort
# DATABASE_URL / DIRECT_URL doivent reprendre EXACTEMENT POSTGRES_USER/PASSWORD/DB
# et viser l'hôte "beyond-db" (nom du service), port interne 5432.
DATABASE_URL=postgresql://beyond:CHANGE_ME_mot_de_passe_fort@beyond-db:5432/beyond_expertise?schema=public
DIRECT_URL=postgresql://beyond:CHANGE_ME_mot_de_passe_fort@beyond-db:5432/beyond_expertise?schema=public

# ── Authentification API (JWT) ─────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_long_aleatoire
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_long_aleatoire
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Anti-spam Cloudflare Turnstile (optionnel — laisser vide pour désactiver)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email SMTP (optionnel — notifications de leads/devis) ───────────────────
SMTP_FROM=hello@beyond-expertise.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Liens espaces LMS (optionnel) ──────────────────────────────────────────
NEXT_PUBLIC_LMS_LEARNER_URL=
NEXT_PUBLIC_LMS_TRAINER_URL=
